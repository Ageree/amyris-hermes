# fleet/local/.env.example — environment variables for the local 2-tenant harness
#
# Copy this file to fleet/local/.env and fill in real values for a live run.
# For the OFFLINE mock-only mode the placeholder values below are sufficient:
# workers call mock_outbound (not real Sendblue/Convex), so no real credentials
# are needed.
#
# SECURITY:
#   - NEVER commit a real .env — it is gitignored.
#   - Rotate any key that was ever printed or pasted in plaintext.
#   - Keep .env chmod 600.

# ---------------------------------------------------------------------------
# Shared secrets — same across all tenant workers in this local harness.
# ---------------------------------------------------------------------------

# Internal shared secret between workers and mock_outbound (mirrors WORKER_SECRET
# in the real Convex deployment). For offline mode "test-secret" is fine.
WORKER_SECRET=test-secret

# ---------------------------------------------------------------------------
# Sendblue channel credentials (shared number; one set for the whole fleet)
# ---------------------------------------------------------------------------
# In offline (mock) mode these are never called — set to placeholders.
SENDBLUE_API_KEY_ID=placeholder-key-id
SENDBLUE_API_SECRET_KEY=placeholder-secret-key
SENDBLUE_FROM_NUMBER=+10000000000

# ---------------------------------------------------------------------------
# MiniMax fast lane (optional — set to blank to disable in mock mode)
# ---------------------------------------------------------------------------
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# ---------------------------------------------------------------------------
# Telegram (optional — blank disables the Telegram channel)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Exa web search (optional)
# ---------------------------------------------------------------------------
EXA_API_KEY=
