# =============================================================================
# Fleet controller environment template
#
# Copy to controller.env and fill with REAL values:
#   cp fleet/controller/.env.example /path/to/controller.env
#
# Deploy:
#   scripts/fleet/deploy-controller.sh --env-file /path/to/controller.env \
#       --smoke --apply
# =============================================================================

# --- Required (deploy-controller.sh validates these are non-empty) ---
CONVEX_URL=https://your-deployment.convex.cloud
WORKER_SECRET=your-shared-worker-secret
IMAGE=us-central1-docker.pkg.dev/hermes-saved-content-lab/saved-content/hermes-fleet:latest
MINIMAX_API_KEY=sk-or-xxx
SENDBLUE_API_KEY_ID=xxx
SENDBLUE_API_SECRET_KEY=xxx
SENDBLUE_FROM_NUMBER=+1xxxxxxxxxx

# --- GCP / fleet host ---
GCP_PROJECT=hermes-saved-content-lab
GCP_REGION=us-central1
GCS_BUCKET=hermes-fleet-state
HOSTS=localhost

# --- Runtime backend: docker (containers on host VM) or gce_vm (one VM per user) ---
RUNTIME_BACKEND=docker

# --- Eve in-container server ---
EVE_PORT=4123
EVE_INGRESS_SECRET=your-eve-ingress-secret

# --- Supermemory (user memory / facts) ---
SUPERMEMORY_API_KEY=sm_xxx
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
SUPERMEMORY_ENABLED=1
SUPERMEMORY_WRITE_ENABLED=1

# --- Sites (Turso hyper-personalized apps) ---
SITES_PUBLISH_SECRET=your-sites-publish-secret

# --- Optional integrations ---
TELEGRAM_BOT_TOKEN=
EXA_API_KEY=

# --- Placement / capacity ---
RAM_HEADROOM_PCT=30
CAPACITY_PER_HOST=50
MAX_LAUNCH_FAILURES=3

# --- Timing ---
POLL_INTERVAL_S=3
STALE_TTL_S=240
MIRROR_INTERVAL_S=300

# --- GCE VM backend (only used when RUNTIME_BACKEND=gce_vm) ---
GCE_ZONE=us-central1-a
GCE_MACHINE_TYPE=e2-standard-2
GCE_BOOT_DISK_SIZE=40GB
GCE_SERVICE_ACCOUNT=
GCE_NETWORK=
GCE_SUBNETWORK=
GCE_SCOPES=cloud-platform
GCE_TAGS=hermes-tenant
GCE_LABELS=app=hermes,component=tenant-agent
