# Fleet controller env — copy to .env (dev) or /etc/hermes-fleet/controller.env
# (prod systemd EnvironmentFile, mode 0600). NEVER commit real secret values.
#
# These are the CONTROLLER's own env; the controller forwards the secret-bearing
# ones into each per-tenant container via docker run (_build_env).

# --- Convex (ADMIN url, NOT the .convex.site webhook host) ---
CONVEX_URL=https://zany-tapir-501.convex.cloud
WORKER_SECRET=__from `cd control-plane && npx convex env get WORKER_SECRET`__

# --- Fleet image (push target = the REAL saved-content AR repo) ---
IMAGE=us-central1-docker.pkg.dev/hermes-saved-content-lab/saved-content/hermes-fleet:latest

# --- Hosts: v1 is a single co-located VM ---
HOSTS=localhost

# --- GCP ---
GCP_PROJECT=hermes-saved-content-lab
GCP_REGION=us-central1
GCS_BUCKET=hermes-fleet-state

# --- Placement / timing (single-VM: keep capacity conservative) ---
CAPACITY_PER_HOST=5
STALE_TTL_S=240
PER_INSTANCE_SECRETS=0

# --- Model: the live key is an OpenRouter key (sk-or-*). Set BASE_URL+MODEL
#     explicitly so there is zero ambiguity (they are also auto-derived). ---
MINIMAX_API_KEY=sk-or-__openrouter_key__
MINIMAX_BASE_URL=https://openrouter.ai/api/v1
MINIMAX_MODEL=minimax/minimax-m3

# --- Channels (injected into each tenant container) ---
SENDBLUE_API_KEY_ID=__sendblue_key_id__
SENDBLUE_API_SECRET_KEY=__sendblue_secret_key__     # EXACT name (not SENDBLUE_API_SECRET)
SENDBLUE_FROM_NUMBER=+16466208124
TELEGRAM_BOT_TOKEN=__e1isabot_token__
EXA_API_KEY=__exa_key__
