# Keep the Cloud Build context small — exclude venvs, git, caches, node_modules.
.git/
**/.venv/
**/__pycache__/
**/.pytest_cache/
node_modules/
.frankenstein/
.claude/
.gitnexus/
*.jsonl
# Web frontend (not needed by fleet or eve-fleet Docker builds).
web/
# Docs / specs / reports not needed inside container builds.
docs/
reports/
specs/
# Secrets must NEVER be uploaded to Cloud Build (defense-in-depth; .env.example kept).
**/.env
**/.env.*
!**/.env.example
**/*-secret
**/.worker-secret
