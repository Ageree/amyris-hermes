{
  "threshold": 3,
  "minLines": 12,
  "minTokens": 80,
  "reporters": ["console", "json"],
  "output": "reports/jscpd",
  "absolute": false,
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.output/**",
    "**/coverage/**",
    "**/cp-generated/**",
    "**/*.tsbuildinfo",
    ".agents/**",
    ".claude/**",
    ".harness/**",
    ".specify/**",
    "docs/**",
    "lab/skills/**"
  ],
  "formats": ["typescript", "javascript", "python"]
}
