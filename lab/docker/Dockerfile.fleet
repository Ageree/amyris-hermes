# =============================================================================
# Dockerfile.fleet — per-tenant Hermes worker container (M6 fleet image)
#
# Build-time arguments
# --------------------
#   HERMES_REF        git ref to clone for the Hermes runtime (default: main).
#                     Only used when INSTALL_HERMES=1.
#   INSTALL_HERMES    1 = clone & install Hermes + Chromium (production).
#                     0 = skip both (hermetic CI gate; default). The in-image
#                     pytest gate uses the network-free tier so it works in
#                     either mode.
#
# Runtime env contract (design §4) — ALL secrets arrive via docker run / compose;
# NOTHING is baked into the image.
#   Required:  WORKER_MODE=scoped  USER_ID  CONVEX_URL  WORKER_SECRET
#              SENDBLUE_API_KEY_ID  SENDBLUE_API_SECRET_KEY  SENDBLUE_FROM_NUMBER
#              MINIMAX_API_KEY  INSTANCE_ID
#   Optional:  TELEGRAM_BOT_TOKEN  TELEGRAM_WEBHOOK_SECRET  EXA_API_KEY
#              MINIMAX_MODEL (default MiniMax-M3)  FAST_LANE_ENABLED  etc.
#   Bind mount: HERMES_HOME — writable host path for persistent agent state
#              (profiles, config, SOUL.md). NEVER baked in; supplied at runtime as
#              a bind mount (/data/tenants/<userId>), not a Docker VOLUME.
#
# NOTE: NO ALLOWED_USER_NUMBER in scoped mode. Routing is done per-row by the
# worker's A2 mechanism (replyTarget / userNumber in the claimed message).
# =============================================================================

ARG INSTALL_HERMES=0
# Pin to an upstream RELEASE TAG (not a moving branch) so a rebuild is
# reproducible. v2026.6.19 = Hermes Agent v0.17.0 ("The Reach Release").
ARG HERMES_REF=v2026.6.19
# Hermes runtime source. Default = upstream NousResearch (public, 197k★, Cloud
# Build clones it with no creds). The old Ageree fork carried no real product
# customizations (only railway cruft + auto-checkpoints), so we install straight
# from upstream. Override via --build-arg HERMES_GIT_URL=... for a private fork.
ARG HERMES_GIT_URL=https://github.com/NousResearch/hermes-agent.git

# ---------------------------------------------------------------------------
# Stage 1: base — system deps, tini, worker Python deps
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS base

# Pin apt at a known digest is impractical in a Dockerfile; instead we only
# install what the image strictly needs and run with --no-install-recommends.
RUN apt-get update && apt-get install -y --no-install-recommends \
        # tini: tiny init for PID 1, guarantees clean SIGTERM handling
        tini \
        # git: needed at build time to clone Hermes when INSTALL_HERMES=1
        git \
        # ca-certificates: TLS chains for API calls
        ca-certificates \
        # curl: healthcheck / smoke curl inside the container
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# pip resilience: heavy installs (esp. the Hermes runtime) can hit transient PyPI
# read timeouts. Retry + a longer timeout make the build robust to network flakes
# (inherited by the isolated build-dependency pip too, via PIP_* env).
ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5

# Copy the skeleton worker modules.  We COPY only what worker.py transitively
# needs at import time so that a change to an unrelated script doesn't bust
# the layer cache.
COPY lab/skeleton/ /app/skeleton/
# Default SOUL voice for the fast lane, baked at the LOWEST-precedence path
# (_load_soul checks ../personality/SOUL.md last) so a per-tenant
# $HERMES_HOME/SOUL.md in the bind mount still overrides it — but a fresh tenant
# with an empty mount gets the lowercase persona instead of a voiceless reply.
COPY lab/personality/SOUL.md /app/personality/SOUL.md
# browser-harness (Lane B): the skill instruction Hermes follows to browse, and
# the container entrypoint that launches headless Chrome-CDP then execs the
# worker. Baked in the base stage so both image variants (INSTALL_HERMES 0/1)
# have them and the worker seed can copy the skill into each tenant's HERMES_HOME.
COPY lab/skills/browser-harness/ /app/skills/browser-harness/
COPY lab/docker/fleet-entrypoint.sh /app/skeleton/fleet-entrypoint.sh
# Copy the test suite so the build-time gate can run it.
COPY lab/tests/    /app/tests/
# Copy lab-level pytest.ini so markers / testpaths are respected.
COPY lab/pytest.ini /app/pytest.ini

# Install Python deps from the skeleton requirements.  We pin to a hash-pinned
# lockfile in production; for now we install from requirements.txt directly and
# accept the version resolution at build time.
RUN pip install --no-cache-dir -r /app/skeleton/requirements.txt

# ---------------------------------------------------------------------------
# Stage 2: optional Hermes + Chromium layer
#   Skipped when INSTALL_HERMES=0 (default) so the hermetic build stays offline.
#   Production Cloud Build passes INSTALL_HERMES=1 and HERMES_REF.
# ---------------------------------------------------------------------------
FROM base AS with-hermes-0
# Nothing to do — Hermes skipped.

FROM base AS with-hermes-1
ARG HERMES_REF
ARG HERMES_GIT_URL
# Install Chromium for the persistent agent-browser profile (headless CDP).
# Guarded inside this stage so the hermetic gate (stage with-hermes-0) stays
# network-free and doesn't pull apt packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
        chromium \
        chromium-driver \
        fonts-liberation \
        libglib2.0-0 \
        libnss3 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libx11-xcb1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxfixes3 \
        libxi6 \
        libxrandr2 \
        libxrender1 \
        libxss1 \
        libxtst6 \
    && rm -rf /var/lib/apt/lists/*

# Clone the Hermes runtime and install it.  The clone target is /opt/hermes-agent
# inside the image; the runtime venv is at /opt/hermes-agent/venv.
# HERMES_HOME is a runtime bind-mount (per-tenant) and must NOT be baked in — it
# holds mutable state (profiles, SOUL.md, config.yaml, .env) that varies per tenant.
# Clone is retried up to 3x: a large shallow clone over a flaky link can drop
# mid-transfer (curl 56 / GnuTLS recv / "early EOF"). postBuffer + low-speed abort
# make a stalled transfer fail fast so the retry kicks in instead of hanging.
RUN git config --global http.postBuffer 524288000 \
    && git config --global http.lowSpeedLimit 1000 \
    && git config --global http.lowSpeedTime 60 \
    && for i in 1 2 3; do \
        rm -rf /opt/hermes-agent \
        && git clone --depth 1 --single-branch --branch "${HERMES_REF}" \
            "${HERMES_GIT_URL}" /opt/hermes-agent \
        && break \
        || { echo "git clone attempt $i failed; retrying in 5s"; sleep 5; }; \
    done \
    && test -d /opt/hermes-agent/.git \
    && python -m venv /opt/hermes-agent/venv \
    && /opt/hermes-agent/venv/bin/pip install --no-cache-dir -e /opt/hermes-agent

# browser-harness (Lane B): self-healing Chrome/CDP browser that Hermes drives
# via its terminal tool (no own LLM loop — Hermes is the only brain). Installed
# in an ISOLATED venv so its pins (cdp-use/websockets/pillow) never collide with
# the worker or Hermes deps; the CLI entry is symlinked onto PATH so a bare
# `browser-harness` resolves for the terminal subprocess. Clone is retried like
# the Hermes clone above (flaky-link resilience).
RUN for i in 1 2 3; do \
        rm -rf /opt/browser-harness \
        && git clone --depth 1 https://github.com/browser-use/browser-harness /opt/browser-harness \
        && break \
        || { echo "browser-harness clone attempt $i failed; retrying in 5s"; sleep 5; }; \
    done \
    && test -d /opt/browser-harness/.git \
    && python -m venv /opt/bh-venv \
    && /opt/bh-venv/bin/pip install --no-cache-dir /opt/browser-harness \
    && ln -sf /opt/bh-venv/bin/browser-harness /usr/local/bin/browser-harness \
    && /usr/local/bin/browser-harness --version

# ---------------------------------------------------------------------------
# Select the correct intermediate stage based on the ARG.
# (Docker doesn't support shell arithmetic in FROM, so we use named stages.)
# ---------------------------------------------------------------------------
FROM with-hermes-${INSTALL_HERMES} AS final

# ---------------------------------------------------------------------------
# In-image build-time test gate
#
# Runs the NETWORK-FREE subset of the lab suite that covers THIS image's shipped
# worker runtime: unit tests, nothing needing a real Convex deployment or a live
# channel. A broken worker.py (bad import, syntax error, logic regression) fails
# the build here, long before it ever reaches a tenant. The gate is HARD: any
# failure or collection error aborts the build (NO "|| true").
#
# Deselected (NOT shipped in the worker image, so they cannot collect here):
#   - the connect-flow / Composio "skill" tests — their subject modules live in
#     lab/skills/connections (invoked INSIDE Hermes, not the worker; Composio is
#     deferred post-v1). The worker only SOFT-imports composio_api.
#   - test_exec_tool.py — exercises a Hermes-side tool, not the worker.
# These are covered by the full host suite (315 tests); here we gate exactly what
# the container ships. --strict-markers + a non-zero exit on collection error
# means an UNEXPECTED uncollectable worker test still fails the build.
#
# The suite lives at /app/tests/; worker modules are at /app/skeleton/ (also on
# PYTHONPATH) so the test-time imports match exactly what the worker sees.
# ---------------------------------------------------------------------------
RUN cd /app && \
    PYTHONPATH=/app/skeleton python3 -m pytest \
        -m "not convex_e2e and not live_channel" \
        -p no:cacheprovider \
        --ignore=/app/tests/test_exec_tool.py \
        --ignore=/app/tests/test_composio_api.py \
        --ignore=/app/tests/test_conn_status.py \
        --ignore=/app/tests/test_connect.py \
        --ignore=/app/tests/test_library.py \
        --ignore=/app/tests/test_pending.py \
        --ignore=/app/tests/test_resolve.py \
        -q \
        tests/

# ---------------------------------------------------------------------------
# Runtime configuration
# ---------------------------------------------------------------------------

# HERMES_HOME is a writable, per-tenant directory supplied at runtime as a host
# BIND MOUNT (controller injects HERMES_HOME=/data/tenants/<userId> and mounts
# that path). We deliberately do NOT declare `VOLUME` here: a VOLUME at an
# unmounted default path creates a dangling anonymous volume per container and
# masks the real contract. The controller's bind mount is the only state surface.

# Expose no ports: the worker is purely outbound (polls Convex, calls APIs).
# A future healthcheck endpoint could be exposed here.

# Default env — overridden at runtime by docker run / compose env_file.
ENV WORKER_MODE=scoped \
    HERMES_HOME=/data/tenants/default \
    HERMES_DIR=/opt/hermes-agent \
    HERMES_PYTHON_BIN=/opt/hermes-agent/venv/bin/python \
    MINIMAX_MODEL=MiniMax-M3 \
    POLL_INTERVAL=0.5 \
    IDLE_POLL_INTERVAL=3.0 \
    FAST_LANE_ENABLED=1 \
    MEDIUM_LANE_ENABLED=1 \
    HISTORY_ENABLED=1 \
    PYTHONPATH=/app/skeleton \
    PYTHONUNBUFFERED=1

# Run the worker as a NON-ROOT user (defense-in-depth: a container escape or a
# rogue tool can't reach the co-located host/controller/other tenants as root).
# uid/gid pinned to 10001 so the VM can chown the host bind-mount dir
# (/data/tenants/<userId>) to the same id deterministically. Created AFTER the
# in-image pytest gate (which runs as root) and BEFORE the worker runs.
RUN groupadd -g 10001 hermes \
    && useradd -u 10001 -g 10001 -m -s /usr/sbin/nologin hermes \
    && mkdir -p /data/tenants/default \
    && chmod +x /app/skeleton/fleet-entrypoint.sh \
    && chown -R hermes:hermes /app /data/tenants \
    && if [ -d /opt/hermes-agent ]; then chown -R hermes:hermes /opt/hermes-agent; fi

WORKDIR /app/skeleton

# tini as PID 1: forwards signals correctly so `docker stop` terminates the
# worker gracefully (SIGTERM -> Python shutdown -> no orphan processes).
ENTRYPOINT ["/usr/bin/tini", "--"]

USER hermes

# Default CMD: the entrypoint launches headless Chrome-CDP for browser-harness
# (Lane B), then execs the worker in scoped mode. All required env vars
# (CONVEX_URL, WORKER_SECRET, USER_ID, etc.) must be injected at runtime.
CMD ["./fleet-entrypoint.sh"]
